{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "faronet-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "faronet-db",
			"database_id": "060ad8ec-ee39-46d5-8623-0833e1d87051",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "SALA", "class_name": "Sala" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala"] }],

	"ratelimits": [{ "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],

	"triggers": { "crons": ["17 * * * *"] },

	"observability": { "enabled": false }
}
